# =============================================================================
# CardLyze Configuration Template
# Copy this file to .env and adjust values for your environment.
# =============================================================================

# Server Binding
CARDLYZE_HOST=127.0.0.1
CARDLYZE_PORT=8000
ALLOW_NON_LOOPBACK=0

# Timezone & Automated Scheduler
CARDLYZE_REPORT_TIMEZONE=Asia/Kolkata
CARDLYZE_DAILY_RUN_DELAY_MINUTES=15
CARDLYZE_AUTO_SCHEDULER_ENABLED=1
CARDLYZE_STARTUP_CATCHUP_ENABLED=1

# Alert Thresholds
CARDLYZE_FREQUENCY_THRESHOLD=3
CARDLYZE_USD_THRESHOLD=1500.0
CARDLYZE_CUMULATIVE_ALERT_THRESHOLD=3

# -----------------------------------------------------------------------------
# Data Source: 'file' (local Excel simulation) or 'sql' (AWS RDS MS SQL Server)
# -----------------------------------------------------------------------------
CARDLYZE_DATA_PROVIDER=file

# AWS RDS MS SQL Server (Required when CARDLYZE_DATA_PROVIDER=sql)
# CARDLYZE_DB_HOST=your-rds-endpoint.amazonaws.com
# CARDLYZE_DB_PORT=1433
# CARDLYZE_DB_NAME=tms_atm_db
# CARDLYZE_DB_USER=your_db_username
# CARDLYZE_DB_PASSWORD=your_db_password
# CARDLYZE_DB_DRIVER=ODBC Driver 17 for SQL Server

# -----------------------------------------------------------------------------
# Report Storage Backend: 'local' (filesystem) or 's3' (LocalStack / AWS S3)
# -----------------------------------------------------------------------------
CARDLYZE_STORAGE_BACKEND=local
CARDLYZE_S3_BUCKET=cardlyze-reports
CARDLYZE_S3_REGION=ap-south-1
CARDLYZE_S3_SAVE_CLEAN_REPORTS=1

# LocalStack S3 Emulator Configuration:
# CARDLYZE_STORAGE_BACKEND=s3
# CARDLYZE_S3_ENDPOINT_URL=http://localhost:4566
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
